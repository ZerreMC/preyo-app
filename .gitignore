# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist/

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — commit only *.example variants
.env
.env.*
supabase/.env
tests/.env
!.env.example
!supabase/.env.example
!tests/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.zed/
.agents/
.idea/

# Supabase local state (generated, not source of truth)
supabase/.temp/
supabase/.branches/
supabase/snippets/*.sql

# SSH keys — never commit private keys
yisus
yisus.pub
yes
yes.pub
*.pem
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Local documentation drafts
scripts/db/README.md
supabase/MIGRATIONS_ROADMAP.md
supabase/README.md
supabase/seed/README.md
