# mock: desarrollo sin backend real.
# supabase: Supabase LXC o Supabase Cloud.
NEXT_PUBLIC_PREYO_DATA_SOURCE=mock

# Públicas del cliente Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo tooling/tests. Nunca cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Cloud / CI. No es secreto.
SUPABASE_PROJECT_REF=

# Migraciones remotas al LXC
PREYO_REMOTE_HOST=
PREYO_REMOTE_USER=
PREYO_REMOTE_SUPABASE_PATH=
PREYO_REMOTE_TMP_DIR=/tmp
PREYO_DB_SERVICE=db
PREYO_DB_USER=postgres
PREYO_DB_NAME=postgres